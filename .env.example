# Copy to .env.local and fill in. Both the dashboard and the worker read .env.local.

# --- Required ---
# Claude (scoring, copywriting, outreach drafts). Pick ONE route:
# a) Anthropic API key from https://console.anthropic.com  (or CLAUDE_PROVIDER=claude-code to use your Claude plan via the installed Claude Code CLI)
CLAUDE_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# b) Claude on Google Cloud Vertex AI (billed to your Google Cloud credits):
# CLAUDE_PROVIDER=vertex
# VERTEX_PROJECT_ID=your-project-id
# VERTEX_REGION=global
# GOOGLE_APPLICATION_CREDENTIALS=C:/Users/you/keys/vertex-service-account.json
# Google Cloud key with "Places API (New)" and "PageSpeed Insights API" enabled.
GOOGLE_API_KEY=

# --- Optional ---
# CLAUDE_MODEL=claude-opus-5-5
# PAGESPEED_API_KEY=            # defaults to GOOGLE_API_KEY
# RUN_PAGESPEED=true            # PageSpeed adds ~20-40s per site; set false for faster scans
# WAPPALYZER_API_KEY=           # extra tech detection; built-in heuristics are used regardless
# PEXELS_API_KEY=              # free at pexels.com/api — much better placeholder photos (otherwise Openverse is used)
# SCAN_CONCURRENCY=3            # parallel jobs in the worker
# BROWSER_CHANNEL=msedge        # msedge | chrome | chromium (Playwright's bundled browser)

# --- Who you are (goes into outreach emails; Spam Act requires sender identification) ---
SENDER_NAME=Kris
SENDER_BUSINESS=
SENDER_EMAIL=
SENDER_PHONE=
SENDER_ABN=
OFFER_PRICE=$1,200

# --- Preview hosting ---
# The ./previews folder is a plain static site (one folder per demo, noindex everywhere).
# Point a subdomain at any static host and give the deploy command, e.g. Cloudflare Pages:
# PREVIEW_PUBLIC_BASE=https://preview.yourcompany.com
# PREVIEW_DEPLOY_CMD=npx wrangler pages deploy previews --project-name=my-previews --branch=main
# (Netlify: npx netlify deploy --dir=previews --prod   Vercel: npx vercel deploy previews --prod --yes)
APP_URL=http://127.0.0.1:3000
